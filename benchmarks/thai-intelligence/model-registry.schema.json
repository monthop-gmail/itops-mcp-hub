{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/monthop-gmail/itops-mcp-hub/benchmarks/thai-intelligence/model-registry.schema.json",
  "title": "Thai Intelligence Model Registry v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "models"],
  "properties": {
    "schema_version": { "const": "0.1" },
    "models": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "developer", "revision", "artifact_sha256", "roles", "modality", "license", "deployment", "evidence_status", "approval_status"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "developer": { "type": "string", "minLength": 1 },
          "revision": { "type": "string", "minLength": 1 },
          "artifact_sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
          "roles": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["thai_text", "thai_context", "ocr", "agent", "legal", "finance", "embedding", "reranking", "classification", "asr"] } },
          "modality": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["text", "image", "audio"] } },
          "license": { "type": "string", "minLength": 1 },
          "terms_url": { "type": ["string", "null"], "format": "uri" },
          "deployment": { "enum": ["self_host", "hosted_api", "both", "unknown"] },
          "api_contract": { "type": ["string", "null"] },
          "requires_remote_code": { "type": ["boolean", "null"] },
          "tokenizer_revision": { "type": ["string", "null"] },
          "processor_revision": { "type": ["string", "null"] },
          "tested_context_tokens": { "type": ["integer", "null"], "minimum": 1 },
          "tested_vram_gib": { "type": ["number", "null"], "minimum": 0 },
          "data_residency": { "type": ["string", "null"] },
          "evidence_status": { "enum": ["publisher_claim", "reproduced", "unverified"] },
          "benchmark_refs": { "type": "array", "items": { "type": "string" } },
          "known_failures": { "type": "array", "items": { "type": "string" } },
          "approval_status": { "enum": ["candidate", "benchmarked", "approved", "rejected"] },
          "rollback_to": { "type": ["string", "null"] }
        }
      }
    }
  }
}
