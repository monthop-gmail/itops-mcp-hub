{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/monthop-gmail/itops-mcp-hub/benchmarks/thai-intelligence/evidence-source-registry.schema.json",
  "title": "Thai Intelligence Evidence Source Registry v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "sources"],
  "properties": {
    "schema_version": { "const": "0.1" },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "authority", "uri", "document_id", "jurisdiction", "retrieved_at", "sha256", "access_class", "rights", "status"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "authority": { "type": "string", "minLength": 1 },
          "uri": { "type": "string", "minLength": 1 },
          "document_id": { "type": "string", "minLength": 1 },
          "jurisdiction": { "type": "string", "minLength": 1 },
          "issued_on": { "type": ["string", "null"], "format": "date" },
          "effective_from": { "type": ["string", "null"], "format": "date" },
          "effective_to": { "type": ["string", "null"], "format": "date" },
          "retrieved_at": { "type": "string", "format": "date-time" },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "page": { "type": ["integer", "null"], "minimum": 1 },
          "section": { "type": ["string", "null"] },
          "span": { "type": ["string", "null"] },
          "access_class": { "enum": ["public", "internal", "restricted"] },
          "rights": { "type": "string", "minLength": 1 },
          "status": { "enum": ["current", "superseded", "unknown"] }
        }
      }
    }
  }
}
