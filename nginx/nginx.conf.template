# nginx.conf.template — envsubst replaces ${IT_TOKEN}, ${ADMIN_TOKEN}, ${PUBLIC_MCP_ORIGIN}.
worker_processes auto;
error_log /var/log/nginx/error.log warn;
pid /tmp/nginx.pid;

events {
    worker_connections 1024;
}

http {
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;
    sendfile      on;
    server_tokens off;
    charset       utf-8;
    map_hash_bucket_size 128;

    # Log only URI path (without query) to avoid leaking secrets in access logs.
    log_format main '$remote_addr $mcp_role $request_method $uri $server_protocol $status $body_bytes_sent rt=$request_time';
    access_log /var/log/nginx/access.log main;
    underscores_in_headers on;

    map $http_upgrade $connection_upgrade {
        default upgrade;
        ''      '';
    }

    # Exact match of `Authorization: Bearer <token>` to an MCP role.
    map $http_authorization $mcp_role {
        default                 "";
        "Bearer ${IT_TOKEN}"    "it";
        "Bearer ${ADMIN_TOKEN}" "admin";
    }

    # Re-resolve Compose service names so recreate does not pin stale IPs.
    resolver 127.0.0.11 valid=10s ipv6=off;

    upstream mcp_oauth {
        server mcp-oauth:3000;
        keepalive 8;
    }

    server {
        listen 80 default_server;
        listen [::]:80 default_server;
        server_name _;

        root /usr/share/nginx/html;
        index index.html;

        client_max_body_size 8m;
        client_body_timeout 60s;

        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy no-referrer always;
        add_header X-Frame-Options DENY always;

        location = /healthz {
            default_type application/json;
            add_header Cache-Control "no-store";
            return 200 '{"ok":true,"service":"itops-nginx-gateway"}';
        }

        location ^~ /.well-known/oauth-authorization-server {
            proxy_pass http://mcp_oauth;
            include /etc/nginx/oauth_proxy.conf;
        }

        location ^~ /.well-known/oauth-protected-resource {
            proxy_pass http://mcp_oauth;
            include /etc/nginx/oauth_proxy.conf;
        }

        location = /.well-known/openid-configuration {
            proxy_pass http://mcp_oauth;
            include /etc/nginx/oauth_proxy.conf;
        }

        location = /oauth/setup {
            proxy_pass http://mcp_oauth;
            include /etc/nginx/oauth_proxy.conf;
        }

        location = /authorize {
            proxy_pass http://mcp_oauth;
            include /etc/nginx/oauth_proxy.conf;
        }

        location = /token {
            proxy_pass http://mcp_oauth;
            include /etc/nginx/oauth_proxy.conf;
        }

        location = /register {
            proxy_pass http://mcp_oauth;
            include /etc/nginx/oauth_proxy.conf;
        }

        location = /mcp/it {
            return 308 /mcp/it/;
        }

        location = /mcp/admin {
            return 308 /mcp/admin/;
        }

        location /mcp/it/ {
            if ($request_method = OPTIONS) {
                add_header Access-Control-Allow-Origin * always;
                add_header Access-Control-Allow-Methods "GET, POST, DELETE, OPTIONS" always;
                add_header Access-Control-Allow-Headers "Authorization, Content-Type, MCP-Protocol-Version, mcp-session-id, Last-Event-ID" always;
                add_header Access-Control-Max-Age 86400 always;
                add_header Access-Control-Expose-Headers "WWW-Authenticate, mcp-session-id" always;
                return 204;
            }

            auth_request /_auth_it;
            error_page 401 = @error401_it;
            error_page 403 = @error403;

            set $mcp_it_upstream mcp-hub-it:3000;
            rewrite ^/mcp/it/(.*)$ /$1 break;
            proxy_pass http://$mcp_it_upstream;
            include /etc/nginx/mcp_proxy.conf;
        }

        location /mcp/admin/ {
            if ($request_method = OPTIONS) {
                add_header Access-Control-Allow-Origin * always;
                add_header Access-Control-Allow-Methods "GET, POST, DELETE, OPTIONS" always;
                add_header Access-Control-Allow-Headers "Authorization, Content-Type, MCP-Protocol-Version, mcp-session-id, Last-Event-ID" always;
                add_header Access-Control-Max-Age 86400 always;
                add_header Access-Control-Expose-Headers "WWW-Authenticate, mcp-session-id" always;
                return 204;
            }

            auth_request /_auth_admin;
            error_page 401 = @error401_admin;
            error_page 403 = @error403;

            set $mcp_admin_upstream mcp-hub-admin:3000;
            rewrite ^/mcp/admin/(.*)$ /$1 break;
            proxy_pass http://$mcp_admin_upstream;
            include /etc/nginx/mcp_proxy.conf;
        }

        # Internal RBAC helpers — keep `if` out of proxy locations except OPTIONS.
        location = /_auth_it {
            internal;
            if ($mcp_role = "") { return 401; }
            if ($mcp_role = "it") { return 200; }
            if ($mcp_role = "admin") { return 200; }
            return 403;
        }

        location = /_auth_admin {
            internal;
            if ($mcp_role = "") { return 401; }
            if ($mcp_role = "admin") { return 200; }
            return 403;
        }

        location @error401_it {
            default_type application/json;
            add_header Access-Control-Allow-Origin * always;
            add_header Access-Control-Expose-Headers "WWW-Authenticate, mcp-session-id" always;
            add_header WWW-Authenticate 'Bearer realm="itops-mcp", resource_metadata="${PUBLIC_MCP_ORIGIN}/.well-known/oauth-protected-resource/mcp/it/mcp", scope="mcp:it"' always;
            return 401 '{"error":"unauthorized","message":"Missing or invalid Authorization Bearer token"}';
        }

        location @error401_admin {
            default_type application/json;
            add_header Access-Control-Allow-Origin * always;
            add_header Access-Control-Expose-Headers "WWW-Authenticate, mcp-session-id" always;
            add_header WWW-Authenticate 'Bearer realm="itops-mcp", resource_metadata="${PUBLIC_MCP_ORIGIN}/.well-known/oauth-protected-resource/mcp/admin/mcp", scope="mcp:admin"' always;
            return 401 '{"error":"unauthorized","message":"Missing or invalid Authorization Bearer token"}';
        }

        location @error403 {
            default_type application/json;
            add_header Access-Control-Allow-Origin * always;
            return 403 '{"error":"forbidden","message":"IT role cannot access /mcp/admin/"}';
        }

        location / {
            try_files $uri $uri/ /index.html;
        }
    }
}
