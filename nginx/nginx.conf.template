# nginx.conf.template — envsubst injects role tokens at container startup.
worker_processes auto;
error_log /var/log/nginx/error.log warn;
pid /tmp/nginx.pid;

events {
    worker_connections 1024;
}

http {
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;
    sendfile      on;
    server_tokens off;
    charset       utf-8;
    map_hash_bucket_size 128;

    # Log only URI path (without query) to avoid leaking secrets in access logs.
    log_format main '$remote_addr $mcp_effective_role $request_method $uri $server_protocol $status $body_bytes_sent rt=$request_time';
    access_log /var/log/nginx/access.log main;
    underscores_in_headers on;

    # Exact match of `Authorization: Bearer <token>` to an MCP role.
    map $http_authorization $mcp_role {
        default                 "";
        "Bearer ${IT_TOKEN}"    "it";
        "Bearer ${ADMIN_TOKEN}" "admin";
    }

    # Header-only auth mode: only Authorization Bearer tokens are accepted.
    map $mcp_role $mcp_effective_role {
        default "";
        "it"    "it";
        "admin" "admin";
    }

    map "${ALLOW_PUBLIC_IT}" $allow_public_it {
        default "false";
        "true"  "true";
        "1"     "true";
        "yes"   "true";
        "on"    "true";
    }

    map "${ALLOW_PUBLIC_ADMIN}" $allow_public_admin {
        default "false";
        "true"  "true";
        "1"     "true";
        "yes"   "true";
        "on"    "true";
    }

    map "$mcp_effective_role:$allow_public_it" $mcp_it_allowed {
        default "false";
        "~^(it|admin):" "true";
        ":true" "true";
    }

    map "$mcp_effective_role:$allow_public_admin" $mcp_admin_status {
        default "403";
        ":false" "401";
        "admin:false" "200";
        ":true" "200";
        "it:true" "200";
        "admin:true" "200";
    }

    map $http_upgrade $connection_upgrade {
        default upgrade;
        ''      '';
    }

    # Re-resolve Compose service names so hub recreate does not pin stale IPs.
    resolver 127.0.0.11 valid=10s ipv6=off;

    server {
        listen 80 default_server;
        listen [::]:80 default_server;
        server_name _;

        root /usr/share/nginx/html;
        index index.html;

        client_max_body_size 8m;
        client_body_timeout 60s;

        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy no-referrer always;
        add_header X-Frame-Options DENY always;

        location = /healthz {
            default_type application/json;
            add_header Cache-Control "no-store";
            return 200 '{"ok":true,"service":"itops-nginx-gateway"}';
        }

        location = /mcp/it {
            return 308 /mcp/it/;
        }

        location = /mcp/admin {
            return 308 /mcp/admin/;
        }

        location /mcp/it/ {
            default_type application/json;
            if ($mcp_it_allowed != "true") {
                add_header WWW-Authenticate 'Bearer realm="itops-mcp"' always;
                return 401 '{"error":"unauthorized","message":"Missing or invalid token (Authorization Bearer only)"}';
            }

            set $mcp_it_upstream mcp-hub-it:3000;
            rewrite ^/mcp/it/(.*)$ /$1 break;
            proxy_pass http://$mcp_it_upstream;
            include /etc/nginx/mcp_proxy.conf;
        }

        location /mcp/admin/ {
            default_type application/json;
            if ($mcp_admin_status = "401") {
                add_header WWW-Authenticate 'Bearer realm="itops-mcp"' always;
                return 401 '{"error":"unauthorized","message":"Missing or invalid token (Authorization Bearer only)"}';
            }
            if ($mcp_admin_status = "403") {
                return 403 '{"error":"forbidden","message":"IT role cannot access /mcp/admin/"}';
            }

            set $mcp_admin_upstream mcp-hub-admin:3000;
            rewrite ^/mcp/admin/(.*)$ /$1 break;
            proxy_pass http://$mcp_admin_upstream;
            include /etc/nginx/mcp_proxy.conf;
        }

        # OAuth and query-token login shims are intentionally disabled.
        # This gateway accepts only Authorization: Bearer <token>.
        location ~ ^/(?:\\.well-known/(?:oauth-protected-resource|oauth-authorization-server|openid-configuration)(?:/.*)?|mcp/(?:admin|it)/mcp/\\.well-known/(?:oauth-protected-resource|oauth-authorization-server|openid-configuration)/?)$ {
            default_type application/json;
            return 404 '{"error":"not_found","message":"OAuth metadata is disabled; use Authorization Bearer tokens"}';
        }

        location ^~ /oauth/ {
            default_type application/json;
            return 403 '{"error":"forbidden","message":"OAuth endpoints are disabled; use Authorization Bearer tokens"}';
        }

        location / {
            try_files $uri $uri/ /index.html;
        }
    }
}
