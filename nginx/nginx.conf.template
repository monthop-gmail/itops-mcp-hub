# nginx.conf.template — envsubst replaces ${IT_TOKEN} and ${ADMIN_TOKEN} only.
worker_processes auto;
error_log /var/log/nginx/error.log warn;
pid /tmp/nginx.pid;

events {
    worker_connections 1024;
}

http {
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;
    sendfile      on;
    server_tokens off;
    charset       utf-8;
    map_hash_bucket_size 128;

    # Log only URI path (without query) to avoid leaking api_key in access logs.
    log_format main '$remote_addr $mcp_effective_role $request_method $uri $server_protocol $status $body_bytes_sent rt=$request_time';
    access_log /var/log/nginx/access.log main;
    underscores_in_headers on;

    # Exact match of `Authorization: Bearer <token>` to an MCP role.
    map $http_authorization $mcp_role {
        default                 "";
        "Bearer ${IT_TOKEN}"    "it";
        "Bearer ${ADMIN_TOKEN}" "admin";
    }

    # Fallback for clients/connectors that cannot set Authorization header:
    # pass `?api_key=<IT_TOKEN|ADMIN_TOKEN>` in the MCP endpoint URL.
    map $arg_api_key $mcp_role_from_query {
        default                 "";
        "${IT_TOKEN}"           "it";
        "${ADMIN_TOKEN}"        "admin";
    }

    map "$mcp_role:$mcp_role_from_query" $mcp_effective_role {
        default     "";
        "~^(it|admin):"  $mcp_role;
        ":it"            "it";
        ":admin"         "admin";
    }

    map $http_upgrade $connection_upgrade {
        default upgrade;
        ''      '';
    }

    upstream mcp_hub_it {
        server mcp-hub-it:3000;
        keepalive 16;
    }

    upstream mcp_hub_admin {
        server mcp-hub-admin:3000;
        keepalive 16;
    }

    server {
        listen 80 default_server;
        listen [::]:80 default_server;
        server_name _;

        root /usr/share/nginx/html;
        index index.html;

        client_max_body_size 8m;
        client_body_timeout 60s;

        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy no-referrer always;
        add_header X-Frame-Options DENY always;

        location = /healthz {
            default_type application/json;
            add_header Cache-Control "no-store";
            return 200 '{"ok":true,"service":"itops-nginx-gateway"}';
        }

        location = /mcp/it {
            return 308 /mcp/it/;
        }

        location = /mcp/admin {
            return 308 /mcp/admin/;
        }

        location /mcp/it/ {
            default_type application/json;
            if ($mcp_effective_role = "") {
                add_header WWW-Authenticate 'Bearer realm="itops-mcp"' always;
                return 401 '{"error":"unauthorized","message":"Missing or invalid token (Authorization Bearer or api_key query)"}';
            }

            proxy_pass http://mcp_hub_it/;
            include /etc/nginx/mcp_proxy.conf;
        }

        location /mcp/admin/ {
            default_type application/json;
            if ($mcp_effective_role = "") {
                add_header WWW-Authenticate 'Bearer realm="itops-mcp"' always;
                return 401 '{"error":"unauthorized","message":"Missing or invalid token (Authorization Bearer or api_key query)"}';
            }
            if ($mcp_effective_role != "admin") {
                return 403 '{"error":"forbidden","message":"IT role cannot access /mcp/admin/"}';
            }

            proxy_pass http://mcp_hub_admin/;
            include /etc/nginx/mcp_proxy.conf;
        }

        location / {
            try_files $uri $uri/ /index.html;
        }
    }
}
