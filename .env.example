# =============================================================================
# IT Operations Hub — environment template
# Copy to .env and replace every change-me value before `docker compose up -d`.
# Generate tokens with:  openssl rand -hex 32
# =============================================================================

# --- Timezone (Zabbix PHP + MeshCentral + Postgres) ---
TZ=Asia/Bangkok

# --- Cloudflare Tunnel -------------------------------------------------------
# Token from Zero Trust → Networks → Tunnels → Configure → token.
# Leave empty to run LAN/VPN-only (cloudflared stays idle).
CLOUDFLARE_TUNNEL_TOKEN=

# Public hostname you will bind to this tunnel (documentation / MCP client URLs)
PUBLIC_MCP_HOSTNAME=mcp.example.com

# --- Nginx RBAC bearer tokens ------------------------------------------------
# Must be unique. Use URL-safe characters only: A-Z a-z 0-9 . _ - ~
# Nginx maps the exact header:  Authorization: Bearer <token>
IT_TOKEN=change-me-it-token
ADMIN_TOKEN=change-me-admin-token
# Allow anonymous access on /mcp/it/* for connector UIs that cannot complete auth
# (keep false in production unless you intentionally want public read-only IT tools)
ALLOW_PUBLIC_IT=false

# --- LAN publish ports (bind on the compose host for VPN/LAN access) ---------
MCP_LAN_PORT=9080
ZABBIX_WEB_LAN_PORT=9443
ZABBIX_SERVER_LAN_PORT=10051
MESHCENTRAL_HTTPS_PORT=9444
MESHCENTRAL_AGENT_PORT=4433

# --- Zabbix 7.x --------------------------------------------------------------
ZABBIX_DB_USER=zabbix
ZABBIX_DB_PASSWORD=change-me-zabbix-db-password
ZABBIX_DB_NAME=zabbix

# Default web UI login on first boot is Admin / zabbix — change it immediately.
ZABBIX_WEB_USER=Admin
ZABBIX_WEB_PASSWORD=zabbix

# API token created in Zabbix UI: User settings → API tokens (or scripts/create-zabbix-api-token.mjs)
ZABBIX_API_URL=http://zabbix-web:8080/api_jsonrpc.php
ZABBIX_API_TOKEN=change-me-zabbix-api-token

# --- MeshCentral -------------------------------------------------------------
MESHCENTRAL_HOSTNAME=mesh.example.com
MESHCENTRAL_URL=https://meshcentral:443
MESHCENTRAL_USER=admin
MESHCENTRAL_PASSWORD=change-me-meshcentral-admin-password
# Used as the MeshCentral password when MESHCENTRAL_PASSWORD is empty, or as an extra
# login secret. Prefer a dedicated MeshCentral service account, not a shared human password.
MESHCENTRAL_API_KEY=change-me-meshcentral-api-key
# Internal image uses a self-signed certificate; keep true unless you mounted real certs.
MESHCENTRAL_TLS_INSECURE=true
MESHCENTRAL_ALLOW_NEW_ACCOUNTS=true
MESHCENTRAL_SESSION_KEY=change-me-meshcentral-session-key-32chars

# Optional 2FA numeric token for the MeshCentral service account (leave empty if unused)
MESHCENTRAL_2FA_TOKEN=
