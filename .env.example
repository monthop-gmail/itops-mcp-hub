# =============================================================================
# IT Operations Hub — environment template
# Copy to .env and replace every change-me value before `docker compose up -d`.
# Generate tokens with:  openssl rand -hex 32
# =============================================================================

# --- Timezone (Zabbix PHP + MeshCentral + Postgres) ---
TZ=Asia/Bangkok

# --- Cloudflare Tunnel -------------------------------------------------------
# Token from Zero Trust → Networks → Tunnels → Configure → token.
# Leave empty to run LAN/VPN-only (cloudflared stays idle).
CLOUDFLARE_TUNNEL_TOKEN=

# Public hostname you will bind to this tunnel (documentation / MCP client URLs)
PUBLIC_MCP_HOSTNAME=mcp.example.com
# Origin advertised in OAuth discovery (no trailing slash). ChatGPT/Grok open this host.
# Example for kknang: https://mcp-kknang.sumana.org
PUBLIC_MCP_ORIGIN=https://mcp.example.com

# --- Nginx RBAC bearer tokens ------------------------------------------------
# Must be unique. Use URL-safe characters only: A-Z a-z 0-9 . _ - ~
# Nginx maps the exact header:  Authorization: Bearer <token>
IT_TOKEN=change-me-it-token
ADMIN_TOKEN=change-me-admin-token
# สมุดบัญชี Express / Allinone / Odoo — คนละบทบาทกับ IT/admin
ACCOUNTING_TOKEN=change-me-accounting-token
# express (ค่าเริ่ม, kknang) | allinone (MTR) | odoo (ICB, ต่อไป NST)
ACCOUNTING_PRODUCT=express

# --- Odoo (ICB ใช้แล้ว จะผลัก NST — MTR ไม่ใช้) -------------------------------
# ใช้เมื่อ ACCOUNTING_PRODUCT=odoo
# fixture = ข้อมูลตัวอย่าง; jsonrpc = Odoo local หรือ SaaS ผ่าน /jsonrpc (API key ชนิด rpc)
# ไม่ใช้ Cloudflare Worker — ฮับนี้มี Nginx Bearer + OAuth อยู่แล้ว
# พอร์ตเครื่องมือจาก https://github.com/monthop-gmail/cf-odoo-mcp-server
ODOO_BACKEND=fixture
ODOO_ALLOW_WRITE=false
ODOO_URL=
ODOO_DB=
ODOO_USERNAME=
ODOO_PASSWORD=
# ทางเลือกหลายตัว: JSON {"default_server":"icb","servers":{"icb":{"url":"http://host.docker.internal:8069","db":"...","username":"...","password":"..."}}}
ODOO_SERVERS=
# ค่าเริ่มกัน ir.* / res.users* / res.groups* — ลงท้าย * ด้วย ไม่งั้น res.users.apikeys หลุด
ODOO_BLOCKED_MODELS=ir.*,res.users*,res.groups*
ODOO_ALLOWED_MODELS=

# --- LAN publish ports (bind on the compose host for VPN/LAN access) ---------
MCP_LAN_PORT=9080
ZABBIX_WEB_LAN_PORT=9443
ZABBIX_SERVER_LAN_PORT=10051
MESHCENTRAL_HTTPS_PORT=9444
MESHCENTRAL_AGENT_PORT=4433

# --- Zabbix 7.x --------------------------------------------------------------
ZABBIX_DB_USER=zabbix
ZABBIX_DB_PASSWORD=change-me-zabbix-db-password
ZABBIX_DB_NAME=zabbix

# Default web UI login on first boot is Admin / zabbix — change it immediately.
ZABBIX_WEB_USER=Admin
ZABBIX_WEB_PASSWORD=zabbix

# API token created in Zabbix UI: User settings → API tokens (or scripts/create-zabbix-api-token.mjs)
ZABBIX_API_URL=http://zabbix-web:8080/api_jsonrpc.php
ZABBIX_API_TOKEN=change-me-zabbix-api-token

# --- MeshCentral -------------------------------------------------------------
MESHCENTRAL_HOSTNAME=mesh.example.com
MESHCENTRAL_URL=https://meshcentral:443
MESHCENTRAL_USER=admin
MESHCENTRAL_PASSWORD=change-me-meshcentral-admin-password
# Used as the MeshCentral password when MESHCENTRAL_PASSWORD is empty, or as an extra
# login secret. Prefer a dedicated MeshCentral service account, not a shared human password.
MESHCENTRAL_API_KEY=change-me-meshcentral-api-key
# Internal image uses a self-signed certificate; keep true unless you mounted real certs.
MESHCENTRAL_TLS_INSECURE=true
MESHCENTRAL_ALLOW_NEW_ACCOUNTS=true
MESHCENTRAL_SESSION_KEY=change-me-meshcentral-session-key-32chars

# Optional 2FA numeric token for the MeshCentral service account (leave empty if unused)
MESHCENTRAL_2FA_TOKEN=

# --- Express Accounting (https://express.co.th/) -----------------------------
# ESG ไม่เปิด REST สาธารณะ. ค่าเริ่ม fixture = ข้อมูลตัวอย่างที่ติด sample:true
# http = สะพาน REST ที่คุณเขียนเองบน Windows/Cloud
# dbf  = mount โฟลเดอร์ที่มี ARMAS.DBF / APMAS.DBF / STMAS.DBF / GLMAS.DBF / ARTRN.DBF
# kknang: C:\ExpressI บน Windows = /mnt/c/ExpressI ใน WSL — ตั้ง EXPRESS_BACKEND=dbf
EXPRESS_BACKEND=fixture
EXPRESS_API_URL=
EXPRESS_API_TOKEN=
EXPRESS_HOST_DATA_DIR=./data/express
EXPRESS_DBF_ENCODING=windows-874
EXPRESS_COMPANY_NAME="Express Accounting"

# --- Allinone (https://www.allinonesoft.com/) --------------------------------
# ใช้เมื่อ ACCOUNTING_PRODUCT=allinone (ไซต์ที่ไม่มี Express)
# fixture = ข้อมูลตัวอย่าง; mdb = Allinone VM (.mdb); mysql = Allinone CS
ALLINONE_BACKEND=fixture
ALLINONE_HOST_DATA_DIR=./data/allinone
ALLINONE_MDB_FILE=
ALLINONE_COMPANY_NAME=
ALLINONE_MYSQL_HOST=
ALLINONE_MYSQL_PORT=3306
ALLINONE_MYSQL_USER=
ALLINONE_MYSQL_PASSWORD=
ALLINONE_MYSQL_DATABASE=

# --- ZKTime 5 (https://www.zksoftwarecenter.com/) ----------------------------
# เข้า-ออกงาน บนฮับ IT/admin ไม่ใช่สมุดบัญชี
# fixture = ข้อมูลตัวอย่าง; mdb = att2000.mdb; mssql = SQL Server ของ ZKTime
# kknang ที่ยังไม่มีเครื่องสแกน: ปล่อย fixture ได้
ZKTIME_BACKEND=fixture
ZKTIME_HOST_DATA_DIR=./data/zktime
ZKTIME_MDB_FILE=
ZKTIME_SITE_NAME=
ZKTIME_MSSQL_HOST=
ZKTIME_MSSQL_PORT=1433
ZKTIME_MSSQL_USER=
ZKTIME_MSSQL_PASSWORD=
ZKTIME_MSSQL_DATABASE=att2000
ZKTIME_MSSQL_ENCRYPT=false

# --- pstack (https://github.com/willpower-institute/pstack) ------------------
# ไม่ฝังแพลตฟอร์มในสแตกนี้ — ต่อ POST /mcp ของอินสแตนซ์ที่รันอยู่แล้ว
# fixture = ตัวอย่าง; http = PSTACK_URL + API key psk_ (สิทธิ์ตามเจ้าของ key)
# ไม่เรียกเอเจนต์ Claude ในตัว pstack — ใช้ tool registry อย่างเดียว
PSTACK_BACKEND=fixture
PSTACK_URL=
PSTACK_API_KEY=
PSTACK_TENANT_ID=
PSTACK_ALLOWED_TOOLS=
PSTACK_BLOCKED_TOOLS=

# --- Document RAG (งบประมาณ / ราชการ ต่อไซต์) --------------------------------
# ไม่ต้องตัดโครงสร้างโฟลเดอร์ก่อน. ค่าเริ่ม fixture = เอกสารตัวอย่าง sample:true
# kknang: C:\data\2570 = /mnt/c/data/2570 — ตั้ง RAG_BACKEND=files
RAG_BACKEND=fixture
RAG_HOST_DATA_DIR=./data/docs
RAG_HOST_INDEX_DIR=./data/rag

