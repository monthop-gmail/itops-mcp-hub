# Sidecar env for Cloudflare API only — not MCP / Zabbix / Mesh tokens.
# Copy to .env.xx (gitignored). After scripts/create-cloudflare-tunnel-token.sh
# fills CLOUDFLARE_TUNNEL_TOKEN, copy that value into .env for Compose.
#
# API token needs Account → Cloudflare Tunnel:Edit (and Read).

CF_API_TOKEN=
CF_ACCOUNT_ID=

# Optional. Not used by create-cloudflare-tunnel-token.sh.
# Keep if you also manage DNS for PUBLIC_MCP_HOSTNAME in the same zone.
CF_ZONE_ID=
CF_DOMAIN=example.com

# Optional tunnel name (default in the script: itops-mcp-hub)
CF_TUNNEL_NAME=itops-mcp-hub

# Auto-filled by scripts/create-cloudflare-tunnel-token.sh
CLOUDFLARE_TUNNEL_TOKEN=
